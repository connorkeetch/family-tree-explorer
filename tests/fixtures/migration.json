{
  "description": "Shared API/browser migration grouping contract. Ties use UTF-16 ordinal labels; parenthesized unknown settlements stay named and do not count as settled.",
  "cases": [
    {
      "name": "empty selection",
      "routes": [],
      "expected": {"routes": [], "total": 0, "settled": 0}
    },
    {
      "name": "small named routes with an unknown settlement",
      "colors": {"Danish": "#123456"},
      "routes": [["Danish", "Utah", 2], ["Irish", "(region unknown)", 1]],
      "expected": {
        "routes": [["Danish", "Utah", 2], ["Irish", "(region unknown)", 1]],
        "total": 3,
        "settled": 2
      }
    },
    {
      "name": "eight categories stay named",
      "routes": [
        ["H", "H", 1], ["G", "G", 1], ["F", "F", 1], ["E", "E", 1],
        ["D", "D", 1], ["C", "C", 1], ["B", "B", 1], ["A", "A", 1]
      ],
      "expected": {
        "routes": [
          ["A", "A", 1], ["B", "B", 1], ["C", "C", 1], ["D", "D", 1],
          ["E", "E", 1], ["F", "F", 1], ["G", "G", 1], ["H", "H", 1]
        ],
        "total": 8,
        "settled": 8
      }
    },
    {
      "name": "crowded ties use the same ordinal order across languages",
      "routes": [
        ["\uE000", "\uE000", 1], ["😁", "😁", 1], ["😀", "😀", 1],
        ["F", "F", 1], ["E", "E", 1], ["D", "D", 1],
        ["C", "C", 1], ["B", "B", 1], ["A", "A", 1]
      ],
      "expected": {
        "routes": [
          ["Other origins", "Other states", 2],
          ["A", "A", 1], ["B", "B", 1], ["C", "C", 1], ["D", "D", 1],
          ["E", "E", 1], ["F", "F", 1], ["😀", "😀", 1]
        ],
        "total": 9,
        "settled": 9
      }
    },
    {
      "name": "crowded categories rank by people and retain a rare unknown settlement",
      "routes": [
        ["A", "S1", 9], ["B", "S2", 8], ["C", "S3", 7], ["D", "S4", 6],
        ["E", "S5", 5], ["F", "S6", 4], ["G", "S7", 3],
        ["H", "(region unknown)", 1], ["I", "S8", 1], ["J", "S9", 1]
      ],
      "expected": {
        "routes": [
          ["A", "S1", 9], ["B", "S2", 8], ["C", "S3", 7], ["D", "S4", 6],
          ["E", "S5", 5], ["F", "S6", 4], ["G", "S7", 3],
          ["Other origins", "Other states", 2], ["Other origins", "(region unknown)", 1]
        ],
        "total": 45,
        "settled": 44
      }
    }
  ]
}
