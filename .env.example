# Optional Docker Compose settings. The default setup needs no .env file.
# To customize, copy this file to .env. Never commit your real .env.

# Local browser address: http://localhost:8000 (change this if the port is occupied).
APP_PORT=8000

# Leave blank to generate and persist a unique signing secret in app-data.
# Set a long, random value explicitly for deployments using an external database.
SESSION_SECRET=

# Local HTTP uses 0. Set 1 when hosting behind HTTPS; see docs/SELF_HOSTING.md.
SESSION_HTTPS_ONLY=0

# Optional registration gate for a remotely hosted instance; no invite by default.
INVITE_CODE=

# Optional paid AI analysis. Blank means off. No FamilySearch credentials needed.
OPENROUTER_API_KEY=

# Optional: maximum combined GEDCOM upload size in MiB.
MAX_UPLOAD_MB=512
